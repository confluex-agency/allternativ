# Database (Supabase PostgreSQL)
# Two URLs from Supabase → Connect. Do NOT use "Direct connection": it is
# IPv6-only without the paid IPv4 add-on, and serverless hosts can't reach it.
#   DATABASE_URL         = Transaction pooler (:6543) — used by the app at runtime
#   MIGRATE_DATABASE_URL = Session pooler (:5432)     — used by migrate + seed
DATABASE_URL="postgresql://postgres.xxxxx:password@aws-1-eu-west-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
MIGRATE_DATABASE_URL="postgresql://postgres.xxxxx:password@aws-1-eu-west-1.pooler.supabase.com:5432/postgres"

# Auth — JWT_SECRET MUST be at least 32 characters; generate with: openssl rand -base64 48
JWT_SECRET="generate-a-strong-secret-here-at-least-32-chars"

# Stripe
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."

# Supabase Storage (for images)
NEXT_PUBLIC_SUPABASE_URL="https://xxxxx.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="eyJ..."

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Rate limiting (Upstash Redis) — REQUIRED in production, optional in dev
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Seed (optional — defaults to admin@allternativ.com / ChangeMe!Now-2026)
SEED_ADMIN_EMAIL=""
SEED_ADMIN_PASSWORD=""
