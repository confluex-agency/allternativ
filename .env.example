# Database.
#
# For DEVELOPMENT use the local container, which runs the same MariaDB 11.8 as
# production. The Hostinger user is capped at 500 connections per hour and a
# handful of builds exhausts it:
#
#   docker compose up -d
#   DATABASE_URL="mysql://allternativ:allternativ-dev@127.0.0.1:3307/allternativ"
#
# For staging/production, Hostinger hPanel → Databases → MySQL Databases.
# Same URL for the app, for migrations and for the seed. If the app and the
# database end up on different hosts, the database host has to allow that
# specific IP in hPanel → Remote MySQL. Never open it to "%" (any host).
DATABASE_URL="mysql://user:password@host:3306/database"

# Auth — JWT_SECRET MUST be at least 32 characters; generate with: openssl rand -base64 48
JWT_SECRET="generate-a-strong-secret-here-at-least-32-chars"

# Stripe
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."

# Image storage for the admin — STILL UNDECIDED. The web app's filesystem is
# rebuilt on every deploy, so uploaded images can't live next to the code.
# Nothing in src/ reads these yet.

# Transactional email — the order confirmation.
#
# ⚠️ WITHOUT THESE NOTHING IS SENT, and /checkout/success tells the buyer a
# confirmation is on its way. The queue is built and tested: the order is
# written synchronously and the mail is queued on it (Order.emailStatus), then
# drained by scripts/sweep-orders.ts. A missing provider is NOT counted as a
# failed attempt — the sweep reports the backlog once and changes nothing — so
# setting these later still mails everyone who bought in the meantime.
#
# EMAIL_FROM must be an address on the VERIFIED sending domain (never a Gmail),
# and should be a mailbox somebody reads, because people reply to order
# confirmations. Resend on a subdomain such as send.allternativ.com is the
# recommendation; see CLAUDE.md, "Two providers the client still has to choose".
#
# ⚠️ EMAIL_REPLY_TO matters if EMAIL_FROM is on a sending SUBDOMAIN, which is
# the recommendation. Sending and receiving are configured separately, and the
# subdomain only ever gets the sending half — so it has no MX and no address
# record, and a customer who hits reply gets a bounce. Point this at the real
# Hostinger mailbox on the root domain. Leave it empty only if EMAIL_FROM
# already receives human mail.
#
#   EMAIL_FROM="Allternativ <hola@send.allternativ.com>"
#   EMAIL_REPLY_TO="info@allternativ.com"
RESEND_API_KEY=""
EMAIL_FROM=""
EMAIL_REPLY_TO=""

# Supplier integration (WooCommerce facade at /wp-json/wc/v3).
# WE generate these and hand them to the supplier; they are not given to us.
# Leave empty and the facade answers 503, which is the right state until the
# app is actually deployed where the supplier will point at it.
#   openssl rand -hex 32
WOO_CONSUMER_KEY=""
WOO_CONSUMER_SECRET=""

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Preview mode. Set this and the deployment becomes PRIVATE: every page asks
# for a password, and robots.txt refuses every crawler. Leave it empty and the
# deployment behaves as the real shop.
#
# Two paths stay open either way, and they have to: /api/webhooks (Stripe tells
# us a payment happened) and /wp-json (the supplier reads orders and writes
# tracking back). Both check credentials of their own.
STAGING_PASSWORD=""

# Rate limiting (Upstash Redis).
#
# REQUIRED for the admin login, which refuses to run without it in production:
# unlimited password guesses is an attack, and silently disabling that guard is
# worse than an error somebody has to fix.
#
# NOT required for the storefront. The tracking and discount-code limiters
# guard a free-tier quota rather than security, so without Redis they warn once
# and let the request through. A staging preview needs no Upstash at all.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Seed (optional — defaults to admin@allternativ.com / ChangeMe!Now-2026)
SEED_ADMIN_EMAIL=""
SEED_ADMIN_PASSWORD=""

# Scheduled jobs (sweep / aggregate / cleanup).
#
# The host's cron calls the app over HTTP rather than running a script, because
# a cron shell has neither the dev dependencies nor the app's environment:
#
#   curl -fsS -X POST https://<domain>/api/cron/sweep \
#        -H "Authorization: Bearer $CRON_SECRET"
#
# ⚠️ WITHOUT THIS THE ROUTE ANSWERS 503 AND NOTHING RUNS — including the only
# thing that sends the confirmation email. It fails closed on purpose: the
# endpoint reprocesses payments and deletes rows.
#   openssl rand -hex 32
CRON_SECRET=""
