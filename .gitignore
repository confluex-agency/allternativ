# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — NEVER commit secrets
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env.production
.env*.bak
.env.backup

# .env.example is safe to commit (placeholder values only)
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# prisma generated client
/src/generated/prisma

# secrets & credentials
*.key
*.cert
credentials.json

# Raw photo dumps (source material — app uses the clean /catalog/<slug>/ copies)
/public/catalog/Catalogo/
/public/catalog/**/WhatsApp*
/raw-lentes/

# MCP server configuration.
#
# ⚠️ THESE FILES CARRY API TOKENS. The Hostinger MCP config holds a token that
# can deploy sites, edit DNS and read billing on the whole hosting account, and
# it sits in plain text next to the code. Committing one is not a mistake you
# can undo by deleting the file: it stays in the history, and the token has to
# be revoked rather than removed.
#
# Every spelling is listed because the tools disagree about which one they
# write, and the one that gets committed will be the one that was not listed.
claude.json
.claude.json
.mcp.json
mcp.json
.claude/settings.local.json
