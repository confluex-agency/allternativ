generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

// MySQL / MariaDB (Hostinger Business Web Hosting; PostgreSQL is VPS-only there).
// Gotcha worth remembering: on MySQL, Prisma maps `String` to VARCHAR(191), not
// to unlimited text like on PostgreSQL. Any field that can hold a long value
// (descriptions, URLs, user agents) carries an explicit `@db.` type below.
// 191 is also the utf8mb4 index limit, so every unique/indexed column stays at
// the default on purpose.
datasource db {
  provider = "mysql"
}

// ─── Auth ────────────────────────────────────────────────────────────────────

// Roles as named by the client brief (section 18).
enum AdminRole {
  OWNER // full access: settings, users, commercial data
  ECOMMERCE_ADMIN // products, prices, variants, inventory, promotions, orders
  CONTENT_ADMIN // images, copy, collections, homepage, editorial content
  ANALYTICS_VIEWER // dashboards and reports, no editing
}

model AdminUser {
  id                 String    @id @default(cuid())
  email              String    @unique
  // ⚠️ Nullable since 2026-09-13, and the null means something specific: this
  // person has been INVITED and has not set a password yet. There is no admin
  // self-registration and there must never be — the default role would hand a
  // stranger the dashboards — so an admin row is always created by an OWNER,
  // and it exists before its password does.
  //
  // Every path that authenticates must treat null as "not an account yet",
  // exactly as `Customer.passwordHash` null means "guest, never registered".
  passwordHash       String?   @map("password_hash")
  name               String
  // Least-privileged default on purpose: a row created without an explicit role
  // can read dashboards and nothing else.
  role               AdminRole @default(ANALYTICS_VIEWER)
  mustChangePassword Boolean   @default(true) @map("must_change_password")
  passwordChangedAt  DateTime  @default(now()) @map("password_changed_at")

  // ─ Taking access away without losing who did what ──────────────────────────
  //
  // ⚠️ Deactivated, never deleted — the same rule retired products follow. The
  // audit trail freezes `adminEmail` as a string so it survives either way, but
  // a deleted row makes "who is this person in the log" unanswerable, and the
  // whole point of the trail is that somebody can ask that later.
  isActive       Boolean   @default(true) @map("is_active")
  deactivatedAt  DateTime? @map("deactivated_at")

  // ─ The invitation ──────────────────────────────────────────────────────────
  //
  // Same shape as the customer's password reset, and for the same reasons: the
  // database is the outbox, the sweep is the postman, and the token is stored
  // as it is sent because the row has to be able to produce the link at send
  // time. ⚠️ But this token is worth MORE than a customer's reset link — it
  // hands over a staff account with a role attached — so it lives half as long.
  // See `ADMIN_INVITE_TTL_HOURS`.
  //
  // `invitedByEmail` is frozen as a string, like `AuditLog.adminEmail`, so it
  // still answers "who let this person in" after that person is gone.
  inviteToken       String?           @unique @map("invite_token")
  inviteExpiresAt   DateTime?         @map("invite_expires_at")
  invitedByEmail    String?           @map("invited_by_email")
  inviteEmailStatus QueuedEmailStatus @default(SKIPPED) @map("invite_email_status")
  inviteEmailSentAt DateTime?         @map("invite_email_sent_at")
  inviteEmailAttempts Int             @default(0) @map("invite_email_attempts")
  inviteEmailLastError String?        @map("invite_email_last_error") @db.Text

  // ─ Getting back in ─────────────────────────────────────────────────────────
  //
  // ⚠️ Separate from the invitation columns above, even though both flows end
  // in "set a password through an emailed link". They are not the same event
  // and the difference is visible from the row: an INVITATION goes to a
  // `passwordHash` that is null and says "you now have access"; a RESET goes to
  // an account that already works and says "choose a new password". The sweep's
  // two queues are told apart by exactly that, the two messages say opposite
  // things, and one token doing both would mean the wrong message could carry
  // the wrong meaning.
  //
  // ⚠️ These exist because shipping invitations without them was a hole. An
  // admin who forgot their password had NO way back: `/api/auth` only ever had
  // `change-password`, which requires being signed in, and `inviteAdminUser`
  // refuses an address that already exists — so an OWNER could not even
  // re-send. The only recovery was SQL against production by hand.
  passwordResetToken     String?           @unique @map("password_reset_token")
  passwordResetExpiresAt DateTime?         @map("password_reset_expires_at")
  resetEmailStatus       QueuedEmailStatus @default(SKIPPED) @map("reset_email_status")
  resetEmailSentAt       DateTime?         @map("reset_email_sent_at")
  resetEmailAttempts     Int               @default(0) @map("reset_email_attempts")
  resetEmailLastError    String?           @map("reset_email_last_error") @db.Text

  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  // The queue query: invitations whose mail has not gone out yet.
  @@index([inviteEmailStatus])
  @@index([resetEmailStatus])
  @@map("admin_users")
}

// Section 34: important commercial and content changes must be traceable.
// Deliberately NOT a foreign key to AdminUser — the log has to outlive the
// account that made the change, so the author's email is copied in.
model AuditLog {
  id          String   @id @default(cuid())
  adminUserId String?  @map("admin_user_id")
  adminEmail  String   @map("admin_email")
  action      String // "update" | "create" | "delete" | "publish" ...
  entityType  String   @map("entity_type") // "product" | "price" | "promotion" ...
  entityId    String?  @map("entity_id")
  entityLabel String?  @map("entity_label") @db.VarChar(255) // human name at the time
  oldValue    Json?    @map("old_value")
  newValue    Json?    @map("new_value")
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

// ─── Products ────────────────────────────────────────────────────────────────

enum ProductType {
  OPTICAL
  SUNGLASSES
  BLUE_LIGHT
  READING
}

enum FrameShape {
  ROUND
  SQUARE
  AVIATOR
  CAT_EYE
  RECTANGLE
  OVAL
  BROWLINE
  GEOMETRIC
}

enum FrameMaterial {
  ACETATE
  METAL
  TITANIUM
  TR90
  WOOD
  MIXED
}

enum Gender {
  MEN
  WOMEN
  UNISEX
}

// Publication lifecycle asked for in section 19 of the client brief. Replaces
// the old `isActive` boolean: "hidden" and "discontinued" are different states
// commercially, and a boolean cannot tell them apart.
enum ProductStatus {
  DRAFT
  SCHEDULED
  LIVE
  HIDDEN
  DISCONTINUED
}

// The six image roles defined in section 07. These are also the file-name
// prefixes agreed with the client for the shared photography folder
// (product-01.jpg, model-01.jpg, ...), so importing a drop is a direct mapping.
enum ImageType {
  PRODUCT
  MODEL
  DETAIL
  CASE
  LIFESTYLE
  PACKAGING
}

model Product {
  id                   String         @id @default(cuid())
  name                 String
  slug                 String         @unique
  // The client's own model code, printed in the brief as "ORBITAL — 5312JT".
  // Distinct from ProductVariant.sku, which identifies a buyable colourway.
  code                 String?        @unique
  tagline              String?        @db.VarChar(255)
  description          String?        @db.Text
  // The euro price, and the fallback for any market with no row in
  // `marketPrices`. Kept rather than replaced: a product with no market price
  // yet still has to be sellable, and a null here would be a page that cannot
  // render a figure.
  priceCents           Int            @map("price_cents")
  compareAtPriceCents  Int?           @map("compare_at_price_cents")
  stockQuantity        Int            @default(0) @map("stock_quantity")
  status               ProductStatus  @default(DRAFT)
  launchDate           DateTime?      @map("launch_date")
  isFeatured           Boolean        @default(false) @map("is_featured")
  type                 ProductType
  frameShape           FrameShape?    @map("frame_shape")
  frameMaterial        FrameMaterial? @map("frame_material")
  lensType             String?        @map("lens_type")
  frameColor           String?        @map("frame_color")
  gender               Gender         @default(UNISEX)
  // ─ "The Feeling" (section 09): editorial copy, deliberately separate from
  //   the technical description. Written by the client, not by us. ─
  feeling              String?        @db.Text
  // ─ Published specs (section 08). Only confirmed values should be filled in;
  //   anything left null is simply not shown on the product page. ─
  // Published as written. The frameMaterial enum above stays for filtering, but
  // it cannot express a real spec line like "Injected matte nylon".
  // ─ What one packed pair costs Allternativ, in US CENTS, from the supplier's
  //   commercial invoice: the frame plus the pouch, cloth, leather case, hard
  //   box and logo work that ship with every unit. Held in dollars because that
  //   is the currency it is actually paid in.
  //
  //   Nothing customer-facing ever reads this. It exists so the margin of a
  //   sale can be worked out, which is impossible from the selling price alone.
  supplierCostUsdCents Int?           @map("supplier_cost_usd_cents")
  frameDetail          String?        @map("frame_detail")
  origin               String?
  lensMaterial         String?        @map("lens_material")
  uvProtection         String?        @map("uv_protection") // e.g. "UV400"
  lensCategory         Int?           @map("lens_category") // 0-4, the standard scale
  dimensionsMm         String?        @map("dimensions_mm") // e.g. "50-22-145"
  // ⚠️ DECIMAL, NOT INT, and the one decimal place is the whole point: the
  // supplier's sheets weigh Amplify at 15.4 g and SYNC at 32.7 g. Stored as an
  // integer those become 15 and 33 — near the truth, which on a published spec
  // is the failure this catalogue is built to avoid.
  weightGrams          Decimal?       @map("weight_grams") @db.Decimal(4, 1)
  fit                  String?
  metaTitle            String?        @map("meta_title")
  metaDescription      String?        @map("meta_description") @db.VarChar(255)
  createdAt            DateTime       @default(now()) @map("created_at")
  updatedAt            DateTime       @updatedAt @map("updated_at")

  images        ProductImage[]
  variants      ProductVariant[]
  collections   ProductsOnCollections[]
  orderItems    OrderItem[]
  wishlistItems WishlistItem[]
  marketPrices  MarketPrice[]

  @@map("products")
}

// What a product costs in one market.
//
// The client rejected daily conversion outright: "no queremos simplemente hacer
// una conversión automática del EUR price cada día... esto nos permite controlar
// exactamente cómo se posiciona el producto en cada mercado." So these are six
// chosen numbers, not one number and an exchange rate, and nothing here is ever
// derived from anything else.
//
// It lives in the database rather than in a constant because the checkout
// prices against the database — the basket is in the visitor's browser and can
// be edited — and because section 21 of the brief asks for a per-market price
// the client edits themselves, without a deploy.
//
// One row per product per market, even though every model and colourway
// currently shares a price inside a market. That is a fact about today's
// catalogue, not about the shape of the problem, and a single global number
// would have to be taken apart the first time one model costs more.
model MarketPrice {
  id         String   @id @default(cuid())
  productId  String   @map("product_id")
  // "EU", "GB", "US", "CA", "AU", "NZ". Matches MarketKey in src/lib/markets.ts.
  market     String   @db.VarChar(8)
  // The currency this market is charged in, stored alongside the amount rather
  // than looked up. An amount without its currency is not a price, and a row
  // that outlives a change to the market table would otherwise be unreadable.
  currency   String   @db.VarChar(3)
  priceCents Int      @map("price_cents")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, market])
  @@index([market])
  @@map("market_prices")
}

// A buyable colourway of a product (Orbital black / Orbital silver).
// This is the unit that carries SKU and stock, so it is also the unit the
// supplier ERP (Dianxiaomi) maps against via `supplierSku`.
model ProductVariant {
  id            String   @id @default(cuid())
  productId     String   @map("product_id")
  sku           String   @unique
  colorKey      String   @map("color_key") // "black" — matches mock-data Colorway.key
  colorName     String   @map("color_name") // "Negro" — shown in the selector
  swatch        String? // CSS colour for the selector dot
  priceCents    Int?     @map("price_cents") // null = inherit the product price
  stockQuantity Int      @default(0) @map("stock_quantity")
  isActive      Boolean  @default(true) @map("is_active")
  position      Int      @default(0)
  supplierSku   String?  @map("supplier_sku") // supplier / ERP product code
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  product      Product            @relation(fields: [productId], references: [id], onDelete: Cascade)
  images       ProductImage[]
  orderItems   OrderItem[]
  reservations StockReservation[]

  @@unique([productId, colorKey])
  @@map("product_variants")
}

// Stock is taken the moment a checkout starts, not when payment lands.
//
// Otherwise minutes pass between "yes, there is one left" and "you paid for it",
// and two people can both be told yes. The reservation moves the unit out of
// `stockQuantity` immediately and either becomes a sale or expires back.
//
// Deliberately NOT a queue: overselling is a race on one row, and the database
// settles it with a conditional update. A message broker orders work, which is
// a different problem.
// The cases the eyewear ships in. Bought up front in a fixed quantity, exactly
// like the frames, and consumed one per pair sold.
//
// Kept apart from ProductVariant because a case is not a product: it has no
// price, no page and no SKU of its own, and every model draws from the same two
// pools. Keyed by the values in CASE_COLORS so the code and the table cannot
// drift apart.
model CaseStock {
  key           String   @id // "BLACK" | "WHITE" — matches CASE_COLORS
  name          String
  stockQuantity Int      @default(0) @map("stock_quantity")
  isActive      Boolean  @default(true) @map("is_active")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@map("case_stock")
}

model StockReservation {
  id              String    @id @default(cuid())
  variantId       String    @map("variant_id")
  quantity        Int
  // The case colour this same line is holding, in the same quantity: one case
  // per pair. Riding on the eyewear reservation rather than having its own row
  // means the expiry, the sweep and the release already cover it.
  caseKey         String?   @map("case_key")
  /**
   * Groups every line of one checkout attempt, so they release together.
   */
  groupId         String    @map("group_id")
  stripeSessionId String?   @map("stripe_session_id")
  expiresAt       DateTime  @map("expires_at")
  /**
   * Set when the reservation becomes a sale or is handed back.
   */
  releasedAt      DateTime? @map("released_at")
  /**
   * True when released because it was paid for, false when it timed out.
   */
  consumed        Boolean   @default(false)
  createdAt       DateTime  @default(now()) @map("created_at")

  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@index([groupId])
  @@index([expiresAt, releasedAt])
  @@map("stock_reservations")
}

model ProductImage {
  id        String    @id @default(cuid())
  productId String    @map("product_id")
  variantId String?   @map("variant_id") // null = shared across colourways
  url       String    @db.VarChar(500)
  altText   String?   @map("alt_text") @db.VarChar(255)
  // What the photo shows. Drives the product gallery order (section 07) and lets
  // the collection card find its hover image (section 05).
  type      ImageType @default(PRODUCT)
  position  Int       @default(0)
  isPrimary Boolean   @default(false) @map("is_primary")

  product Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@map("product_images")
}

// ─── Collections / Drops ────────────────────────────────────────────────────
// Sections 03 and 20 of the brief: Allternativ launches through drops, not
// through traditional product categories. A collection owns its own editorial
// identity and its own launch, and products are ordered inside it by hand.

enum CollectionStatus {
  DRAFT
  SCHEDULED
  LIVE
  ARCHIVED
}

model Collection {
  id              String           @id @default(cuid())
  name            String
  slug            String           @unique
  tagline         String?          @db.VarChar(255)
  description     String?          @db.Text
  heroImageUrl    String?          @map("hero_image_url") @db.VarChar(500)
  heroVideoUrl    String?          @map("hero_video_url") @db.VarChar(500)
  status          CollectionStatus @default(DRAFT)
  launchDate      DateTime?        @map("launch_date")
  isFeatured      Boolean          @default(false) @map("is_featured")
  position        Int              @default(0)
  metaTitle       String?          @map("meta_title")
  metaDescription String?          @map("meta_description") @db.VarChar(255)
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")

  products ProductsOnCollections[]

  @@map("collections")
}

model ProductsOnCollections {
  productId    String @map("product_id")
  collectionId String @map("collection_id")
  position     Int    @default(0) // "Reorder products" in section 20

  product    Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  collection Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)

  @@id([productId, collectionId])
  @@map("products_on_collections")
}

// ─── Incoming webhooks ──────────────────────────────────────────────────────

enum WebhookEventStatus {
  PENDING
  PROCESSED
  FAILED
}

// Every Stripe event is written down before anything is done with it.
//
// Stripe already behaves like a durable queue: it retries a failing webhook with
// backoff for up to three days, and `stripeEventId` being unique makes a retry
// harmless. What was missing is the log — with it we can see what failed, why,
// and replay it by hand instead of guessing from an empty response.
model WebhookEvent {
  id            String             @id @default(cuid())
  stripeEventId String             @unique @map("stripe_event_id")
  type          String
  /**
   * The raw event, kept so a failed one can be reprocessed as it arrived.
   */
  payload       Json
  status        WebhookEventStatus @default(PENDING)
  attempts      Int                @default(0)
  lastError     String?            @map("last_error") @db.Text
  processedAt   DateTime?          @map("processed_at")
  createdAt     DateTime           @default(now()) @map("created_at")

  @@index([status])
  @@map("webhook_events")
}

// Every request the supplier's system makes to our WooCommerce facade, whether
// or not we implement the route.
//
// Nobody knows exactly what Dianxiaomi calls when it authorises a store, and
// guessing wastes days. The log is how we find out: connect it, watch what it
// asks for, implement that. Credentials are never written here.
model WooRequestLog {
  id             String   @id @default(cuid())
  method         String
  path           String   @db.VarChar(500)
  query          String?  @db.Text
  body           String?  @db.Text
  authenticated  Boolean  @default(false)
  /**
   * False when the route is one we have not implemented — the interesting ones.
   */
  matched        Boolean  @default(false)
  responseStatus Int
  userAgent      String?  @map("user_agent") @db.VarChar(500)
  createdAt      DateTime @default(now()) @map("created_at")

  @@index([createdAt])
  @@index([matched])
  @@map("woo_request_logs")
}

// ─── Contact form ───────────────────────────────────────────────────────────
// What somebody writes on /contact, kept until it has reached the support
// mailbox. The row is written BEFORE anything is sent, so a provider that is
// down at that moment delays the message instead of losing it; the sweep
// retries it like the other queued mails.
//
// ⚠️ It is personal data held for one purpose, answering the person, so it is
// deleted after `CONTACT_RETENTION_DAYS` by the weekly cleanup. The copy that
// matters lives in the mailbox by then.

enum ContactTopic {
  GENERAL
  CUSTOM
  PRESS
  STOCKIST
}

model ContactMessage {
  id             String            @id @default(cuid())
  name           String            @db.VarChar(120)
  email          String            @db.VarChar(254)
  topic          ContactTopic
  message        String            @db.Text
  // PENDING from birth, unlike every other queue here: there is no history to
  // protect, and a message nobody sends is exactly the failure this prevents.
  emailStatus    QueuedEmailStatus @default(PENDING) @map("email_status")
  emailSentAt    DateTime?         @map("email_sent_at")
  emailAttempts  Int               @default(0) @map("email_attempts")
  emailLastError String?           @map("email_last_error") @db.Text
  createdAt      DateTime          @default(now()) @map("created_at")

  @@index([emailStatus])
  @@index([createdAt])
  @@map("contact_messages")
}

// ─── Newsletter / lead capture ──────────────────────────────────────────────
// Section 16 ("STAY IN THE FREQUENCY") plus the welcome-discount popup: the
// visitor hands over an email in exchange for a code. Kept apart from Customer
// on purpose, because most subscribers never buy and most buyers never opt in.

enum SubscriberStatus {
  PENDING // double opt-in email sent, not confirmed yet
  SUBSCRIBED
  UNSUBSCRIBED
}

model NewsletterSubscriber {
  id               String           @id @default(cuid())
  email            String           @unique
  status           SubscriberStatus @default(PENDING)
  source           String? // "popup" | "footer" | "checkout"
  // Proof of consent. Selling into the EU, the timestamp and where it came from
  // are the record that matters if the consent is ever challenged.
  consentAt        DateTime?        @map("consent_at")
  consentIpHash    String?          @map("consent_ip_hash") // hashed, never raw
  confirmedAt      DateTime?        @map("confirmed_at")
  unsubscribedAt   DateTime?        @map("unsubscribed_at")
  // Every marketing email must carry a working one-click unsubscribe link.
  // Generated up front so no backfill is ever needed.
  unsubscribeToken String           @unique @default(cuid()) @map("unsubscribe_token")
  // Which welcome code this person was handed, so it is not given twice.
  discountCode     String?          @map("discount_code")

  // ─ Double opt-in (D4, 2026-09-23). An address typed into the footer is
  // PENDING until the link mailed to it is clicked: without that, anybody can
  // subscribe anybody, and the first campaign would go to people with no
  // record of having asked. Same queue shape as the other mails, and its own
  // token, never the unsubscribe one: the two links do opposite things.
  confirmToken             String?           @unique @map("confirm_token") @db.VarChar(64)
  confirmExpiresAt         DateTime?         @map("confirm_expires_at")
  confirmEmailStatus       QueuedEmailStatus @default(SKIPPED) @map("confirm_email_status")
  confirmEmailSentAt       DateTime?         @map("confirm_email_sent_at")
  confirmEmailAttempts     Int               @default(0) @map("confirm_email_attempts")
  confirmEmailLastError    String?           @map("confirm_email_last_error") @db.Text

  createdAt        DateTime         @default(now()) @map("created_at")
  updatedAt        DateTime         @updatedAt @map("updated_at")

  @@index([status])
  @@index([confirmEmailStatus])
  @@map("newsletter_subscribers")
}

// ─── Customers & Orders ─────────────────────────────────────────────────────

model Customer {
  id                 String    @id @default(cuid())
  email              String    @unique
  name               String?
  phone              String?
  country            String?
  city               String?
  stripeCustomerId   String?   @unique @map("stripe_customer_id")
  totalSpentCents    Int       @default(0) @map("total_spent_cents")
  orderCount         Int       @default(0) @map("order_count")
  // ─ Account (the ACCOUNT entry in the nav, section 02). Null means the person
  //   bought as a guest and the record was created by the Stripe webhook. ─
  passwordHash       String?   @map("password_hash")
  emailVerifiedAt    DateTime? @map("email_verified_at")
  // Kills tokens issued before the last password change, exactly as
  // `AdminUser.passwordChangedAt` does. Nullable because most rows here are
  // guest buyers who have never had a password at all.
  passwordChangedAt  DateTime? @map("password_changed_at")
  lastLoginAt        DateTime? @map("last_login_at")

  // ─ Proving the address belongs to whoever typed it ─────────────────────────
  //
  // ⚠️ This is not a nicety, it is the whole security of the feature. The
  // Stripe webhook creates a `Customer` row for every GUEST buyer, keyed on the
  // email they paid with. So "register" very often means "put a password on a
  // row that already holds somebody's order history, shipping address and
  // phone number" — and without proof of the address, anyone who knows a
  // buyer's email could register and read all of it.
  //
  // So the account exists on sign-up, but `emailVerifiedAt` is what unlocks
  // order history. See `src/lib/customer-accounts.ts`.
  emailVerificationToken     String?           @unique @map("email_verification_token")
  emailVerificationExpiresAt DateTime?         @map("email_verification_expires_at")
  // Queued and drained by the sweep, like the two order emails and for the
  // same reason. SKIPPED by default: every row that already exists was made by
  // the webhook and has nothing to verify, and the honest word for that is
  // neither "sent" nor "pending".
  verifyEmailStatus          QueuedEmailStatus @default(SKIPPED) @map("verify_email_status")
  verifyEmailSentAt          DateTime?         @map("verify_email_sent_at")
  verifyEmailAttempts        Int               @default(0) @map("verify_email_attempts")
  verifyEmailLastError       String?           @map("verify_email_last_error") @db.Text

  // ─ Getting back in without us ──────────────────────────────────────────────
  //
  // ⚠️ These are SEPARATE columns from the verification ones above, and reusing
  // those would have been the natural-looking mistake. The two links do
  // opposite-sized things: a verification link can only ever mark an address
  // proven, while a reset link IS the account — whoever holds it sets the
  // password. One column pair holding both would mean a token minted for the
  // smaller job could be spent on the larger one.
  //
  // They also queue independently: somebody can ask for a reset while their
  // verification mail is still sitting unsent, and one failing must not
  // describe the other. Same reasoning as the order's two mails.
  passwordResetToken     String?           @unique @map("password_reset_token")
  passwordResetExpiresAt DateTime?         @map("password_reset_expires_at")
  resetEmailStatus       QueuedEmailStatus @default(SKIPPED) @map("reset_email_status")
  resetEmailSentAt       DateTime?         @map("reset_email_sent_at")
  resetEmailAttempts     Int               @default(0) @map("reset_email_attempts")
  resetEmailLastError    String?           @map("reset_email_last_error") @db.Text
  // ─ Section 25 is explicit: having an account is NOT marketing consent. These
  //   are stored separately and the timestamp is the proof of when it was given. ─
  marketingConsent   Boolean   @default(false) @map("marketing_consent")
  marketingConsentAt DateTime? @map("marketing_consent_at")
  notes              String?   @db.Text
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  orders        Order[]
  wishlistItems WishlistItem[]
  sessions      Session[]

  // The queue query: accounts whose verification mail has not gone out yet.
  @@index([verifyEmailStatus])
  // The same, for the reset queue. A separate index because it is a separate
  // queue with a separate drain.
  @@index([resetEmailStatus])
  @@map("customers")
}

enum OrderStatus {
  PENDING
  PAID
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
}

// Where a queued email got to. Its own status, separate from whatever it is
// attached to: an order is PAID whether or not the mail went out, and
// conflating the two would make a mail provider's bad afternoon look like a
// payment problem.
//
// It was called `OrderEmailStatus` while orders were the only thing that
// queued mail. The account-verification email queues the same way, on the same
// four states, drained by the same sweep — so the name lost the "Order".
// ⚠️ On MySQL a Prisma enum is an inline column type, not a database object,
// so the rename produced no migration SQL at all.
enum QueuedEmailStatus {
  PENDING // queued, waiting for the sweep to drain it
  SENT
  FAILED // given up on: too many attempts, or a permanent refusal
  SKIPPED // never queued -- predates the queue, or withheld on purpose
}

model Order {
  id                String      @id @default(cuid())
  orderNumber       String      @unique @map("order_number")
  // WooCommerce identifies orders with an integer, and the supplier's system
  // speaks WooCommerce. Our cuid would very likely break a client that stores
  // the id in a numeric column, so a real integer is kept alongside it.
  wooId             Int         @unique @default(autoincrement()) @map("woo_id")
  customerId        String      @map("customer_id")
  status            OrderStatus @default(PENDING)
  subtotalCents     Int         @map("subtotal_cents")
  shippingCents     Int         @default(0) @map("shipping_cents")
  taxCents          Int         @default(0) @map("tax_cents")
  // ─ Discount actually applied, frozen on the order. Section 22 requires every
  //   promotion to stay linked to the orders it produced, and that only holds if
  //   the order records it: the coupon itself lives in Stripe and can change. ─
  discountCents     Int         @default(0) @map("discount_cents")
  promotionCode     String?     @map("promotion_code")
  // ─ The other side of the sum, frozen at sale time like everything above. ─
  //
  // `shippingCents` above is what the CUSTOMER paid for delivery. This is what
  // the parcel actually costs Allternativ, and the two differ every time an
  // order ships free: from two pairs up the customer pays nothing and the whole
  // cost is absorbed.
  shippingCostCents Int         @default(0) @map("shipping_cost_cents")
  // Stripe's cut. Nullable because the lookup is deliberately best-effort: a
  // hiccup reading the fee must never cost us the order itself.
  paymentFeeCents   Int?        @map("payment_fee_cents")
  totalCents        Int         @map("total_cents")
  refundedCents     Int         @default(0) @map("refunded_cents")
  currency          String      @default("USD")
  notes             String?     @db.Text // internal notes (section 24)
  stripeSessionId   String?     @unique @map("stripe_session_id")
  shippingName      String?     @map("shipping_name")
  shippingAddress   String?     @map("shipping_address") @db.VarChar(255)
  shippingAddress2  String?     @map("shipping_address_2") @db.VarChar(255)
  shippingCity      String?     @map("shipping_city")
  shippingState     String?     @map("shipping_state")
  shippingCountry   String?     @map("shipping_country")
  shippingZip       String?     @map("shipping_zip")
  shippingPhone     String?     @map("shipping_phone")
  // ─ The confirmation email, queued rather than sent ─
  //
  // The success page promises the buyer a confirmation, so this is not
  // optional. It is deliberately NOT sent from the webhook: a mail provider
  // that is slow or down would turn a 400ms handler into a timeout, Stripe
  // would retry a payment that already succeeded, and the event would sit
  // marked failed for three days over something that has nothing to do with
  // the money. The order is written synchronously; the mail is queued here and
  // drained by `scripts/sweep-orders.ts`.
  emailStatus       QueuedEmailStatus @default(PENDING) @map("email_status")
  emailSentAt       DateTime?        @map("email_sent_at")
  emailAttempts     Int              @default(0) @map("email_attempts")
  emailLastError    String?          @map("email_last_error") @db.Text
  // ─ The dispatch email, queued the same way and counted separately ─
  //
  // A second set of columns rather than a second row or a reused one, because
  // an order gets TWO emails and they fail independently: the confirmation can
  // be sent while the dispatch one is still waiting for the supplier to ship,
  // and one of them failing must not describe the other.
  //
  // ⚠️ PENDING here does NOT mean "due". It means "not sent yet", and most
  // orders sit in it legitimately for days. What makes a dispatch email due is
  // the order having shipped AND carrying a tracking number — the sweep asks
  // for both, so an order marked SHIPPED with nothing to track never mails a
  // buyer a notification with no number in it.
  dispatchEmailStatus    QueuedEmailStatus @default(PENDING) @map("dispatch_email_status")
  dispatchEmailSentAt    DateTime?        @map("dispatch_email_sent_at")
  dispatchEmailAttempts  Int              @default(0) @map("dispatch_email_attempts")
  dispatchEmailLastError String?          @map("dispatch_email_last_error") @db.Text
  // ─ Supplier ERP (Dianxiaomi) round-trip ─
  erpExportedAt     DateTime?   @map("erp_exported_at")
  trackingNumber    String?     @map("tracking_number")
  carrier           String?
  shippedAt         DateTime?   @map("shipped_at")
  utmSource         String?     @map("utm_source")
  utmMedium         String?     @map("utm_medium")
  utmCampaign       String?     @map("utm_campaign")
  createdAt         DateTime    @default(now()) @map("created_at")
  updatedAt         DateTime    @updatedAt @map("updated_at")

  customer Customer    @relation(fields: [customerId], references: [id])
  items    OrderItem[]

  // The queue query: paid orders whose mail has not gone out yet.
  @@index([emailStatus])
  // The same query for the other queue. ⚠️ This index has EXISTED since
  // `20260910200000_dispatch_email_queue` created it, but it was never declared
  // here — so the schema and the database disagreed, and the next `migrate
  // diff` anybody ran would have quietly offered to DROP it. Declaring it is
  // the fix; the migration that noticed carries no SQL for it.
  @@index([dispatchEmailStatus])
  @@map("orders")
}

model OrderItem {
  id             String  @id @default(cuid())
  orderId        String  @map("order_id")
  productId      String  @map("product_id")
  variantId      String? @map("variant_id")
  quantity       Int
  unitPriceCents Int     @map("unit_price_cents")
  // Snapshots taken at purchase time — the SKU/name the ERP must ship, even if
  // the catalogue is edited afterwards.
  sku            String?
  productName    String? @map("product_name")
  variantName    String? @map("variant_name")
  // What this pair COST, frozen the same way and for the same reason the price
  // above is. In the order's currency, converted from the supplier's dollars at
  // the rate held in `src/lib/shipping.ts` on the day of the sale.
  //
  // ⚠️ Without this, margin can only ever be worked out against TODAY's cost
  // table. The day the supplier raises a price, every past order silently
  // reprices backwards and the answer to "what did we make last quarter" turns
  // wrong without turning into an error. It cannot be backfilled either: nobody
  // writes down what a thing used to cost.
  unitCostCents  Int?    @map("unit_cost_cents")
  // Case colour is an option of the purchase, not a variant of the product:
  // choosing white does not create a different SKU. It has to survive to the
  // supplier, who ships it (sections 07, 10 and 13).
  caseColor      String? @map("case_color")

  order   Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product         @relation(fields: [productId], references: [id])
  variant ProductVariant? @relation(fields: [variantId], references: [id])

  @@map("order_items")
}

model WishlistItem {
  id         String   @id @default(cuid())
  customerId String   @map("customer_id")
  productId  String   @map("product_id")
  createdAt  DateTime @default(now()) @map("created_at")

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([customerId, productId])
  @@map("wishlist_items")
}

// ─── Analytics & Tracking ───────────────────────────────────────────────────

model Session {
  id              String   @id @default(cuid())
  visitorId       String   @map("visitor_id")
  customerId      String?  @map("customer_id")
  referrer        String?  @db.VarChar(500)
  utmSource       String?  @map("utm_source")
  utmMedium       String?  @map("utm_medium")
  utmCampaign     String?  @map("utm_campaign")
  userAgent       String?  @map("user_agent") @db.VarChar(500)
  deviceType      String?  @map("device_type")
  browser         String?
  os              String?
  country         String?
  city            String?
  ipHash          String?  @map("ip_hash")
  pageCount       Int      @default(0) @map("page_count")
  durationSeconds Int      @default(0) @map("duration_seconds")
  landedAt        DateTime @default(now()) @map("landed_at")

  customer Customer?       @relation(fields: [customerId], references: [id])
  events   TrackingEvent[]

  @@index([visitorId])
  @@index([landedAt])
  @@map("sessions")
}

model TrackingEvent {
  id        String   @id @default(cuid())
  sessionId String   @map("session_id")
  eventType String   @map("event_type")
  pagePath  String?  @map("page_path") @db.VarChar(500)
  timestamp DateTime @default(now())
  metadata  Json?

  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([eventType])
  @@index([timestamp])
  @@index([sessionId])
  @@map("tracking_events")
}

model DailyAnalytics {
  id                 String   @id @default(cuid())
  date               DateTime @unique @db.Date
  totalSessions      Int      @default(0) @map("total_sessions")
  uniqueVisitors     Int      @default(0) @map("unique_visitors")
  pageViews          Int      @default(0) @map("page_views")
  avgSessionDuration Float    @default(0) @map("avg_session_duration")
  bounceRate         Float    @default(0) @map("bounce_rate")
  totalOrders        Int      @default(0) @map("total_orders")
  totalRevenueCents  Int      @default(0) @map("total_revenue_cents")
  conversionRate     Float    @default(0) @map("conversion_rate")
  topSources         Json?    @map("top_sources")
  topCountries       Json?    @map("top_countries")
  topProductsViewed  Json?    @map("top_products_viewed")
  topSearchTerms     Json?    @map("top_search_terms")

  @@map("daily_analytics")
}
